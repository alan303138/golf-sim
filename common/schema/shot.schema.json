{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shot",
  "type": "object",
  "required": [
    "type",
    "schema",
    "shot_id",
    "ts",
    "ball",
    "quality"
  ],
  "properties": {
    "type": {
      "const": "shot"
    },
    "schema": {
      "const": 1
    },
    "shot_id": {
      "type": "string"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "ball": {
      "type": "object",
      "required": [
        "speed_mps",
        "vla_deg",
        "hla_deg",
        "total_spin_rpm",
        "spin_axis_deg",
        "back_spin_rpm",
        "side_spin_rpm"
      ],
      "properties": {
        "speed_mps": {
          "type": "number",
          "minimum": 0
        },
        "vla_deg": {
          "type": "number"
        },
        "hla_deg": {
          "type": "number"
        },
        "total_spin_rpm": {
          "type": "number",
          "minimum": 0
        },
        "spin_axis_deg": {
          "type": "number"
        },
        "back_spin_rpm": {
          "type": "number"
        },
        "side_spin_rpm": {
          "type": "number"
        }
      }
    },
    "club": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "speed_mps": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "path_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "attack_angle_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "face_angle_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "face_to_path_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "dynamic_loft_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "impact_x_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "impact_y_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "estimated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "confidence",
        "sources",
        "spin_measured"
      ],
      "properties": {
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spin_measured": {
          "type": "boolean"
        }
      }
    }
  }
}