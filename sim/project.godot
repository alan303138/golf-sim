[internationalization]

locale/translations=PackedStringArray("res://i18n/strings.zh_TW.translation", "res://i18n/strings.en.translation")
locale/fallback="zh_TW"

[rendering]

textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.55, 0.72, 0.9, 1)
